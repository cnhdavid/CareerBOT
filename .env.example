# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/careerbot?retryWrites=true&w=majority

# JWT Secret (generate a secure random string)
JWT_SECRET=your_secure_jwt_secret_here_change_in_production

# Session Secret (generate a secure random string)
SESSION_SECRET=your_secure_session_secret_here_change_in_production

# Client URL (for CORS)
CLIENT_URL=https://your-vercel-app.vercel.app

# Node Environment
NODE_ENV=production
